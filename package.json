{
  "name": "bottlebound-referee-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && vite build",
    "lint": "eslint . --max-warnings=0",
    "tsc": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:focused": "vitest run tests/shell-state.test.ts tests/readiness.test.ts tests/domain/match.test.ts tests/storage/canonical-storage-probe.test.ts tests/storage/match-store.test.ts tests/rules-reference/rules-reference.contract.test.ts",
    "test:browser": "playwright test",
    "test": "vitest run && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "^0.1.18",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.4.0",
    "@types/sanitize-html": "2.16.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-svelte": "3.23.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "marked": "18.0.11",
    "prettier": "3.9.6",
    "sanitize-html": "2.17.7",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "dependencies": {
    "immer": "^11.1.18"
  }
}
