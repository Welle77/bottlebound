{
  "name": "bottlebound-referee-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:focused": "vitest run src/readiness.test.ts src/domain/match.test.ts src/storage/canonical-storage-probe.test.ts src/storage/match-store.test.ts src/rules-reference/rules-reference.contract.test.ts",
    "test:browser": "playwright test",
    "test": "vitest run && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/sanitize-html": "2.16.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "marked": "18.0.10",
    "prettier": "3.9.6",
    "sanitize-html": "2.17.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
